# Copy to .env (docker compose reads it automatically). Leave blank for open dev mode.

# Protects POST /api/agents/{id}/kill. Must match the engine's AEGIS_API_KEY and the console's NEXT_PUBLIC_AEGIS_API_KEY.
AEGIS_API_KEY=
# Shared secret agents send (X-Agent-Token) when opening their telemetry WebSocket.
AEGIS_AGENT_TOKEN=
# Browser origins allowed to call the gateway / open /ws/frontend (comma separated).
AEGIS_CORS_ORIGINS=http://localhost:3000
