+
+  setKillState: (alert_id, state) =>
+    set((s) => {
+      const next = { ...s.killStates };
+      if (state) next[alert_id] = state;
+      else delete next[alert_id];
+      return { killStates: next };
+    }),
+
+  selectAlert: (selectedAlertId) => set({ selectedAlertId }),
+}));
