 import { create } from 'zustand';
 
+export type Severity = 'LOW' | 'MEDIUM' | 'HIGH' | 'CRITICAL';
+
 export interface Alert {
   alert_id: string;
   time: string;
   agent_id: string;
+  rule_id?: string;
   rule_name: string;
