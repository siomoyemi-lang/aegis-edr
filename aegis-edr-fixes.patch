+    static const char* t = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    std::string out;
+    for (size_t i = 0; i < n; i += 3) {
+        uint32_t v = data[i] << 16;
+        if (i + 1 < n) v |= data[i + 1] << 8;
+        if (i + 2 < n) v |= data[i + 2];
+        out += t[(v >> 18) & 63];
+        out += t[(v >> 12) & 63];
+        out += (i + 1 < n) ? t[(v >> 6) & 63] : '=';
+        out += (i + 2 < n) ? t[v & 63] : '=';
+    }
+    return out;
